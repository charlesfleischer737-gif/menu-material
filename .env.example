# Copy to .env for local development. Keep actual secrets out of Git.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_QUALITY=medium
OPENAI_TEXT_MODEL=gpt-4.1-mini
# Optional accounting estimate per completed image in USD. Not an invoice amount.
# When set, each finished image counts this much against the daily AI budgets
# (never more than AI_IMAGE_RESERVE_USD). Blank, it counts the cost of the usage
# the Images API reports, at the AI_IMAGE_*_USD_PER_MILLION_TOKENS prices below;
# an image whose usage isn't reported keeps its full reservation.
IMAGE_COST_ESTIMATE_USD=
# Generate independent random values with: openssl rand -hex 32
ADMIN_SETUP_KEY=
JOB_RUNNER_SECRET=
APP_ORIGIN=http://127.0.0.1:5173
# With --once (a scheduler running the worker every minute), the worker keeps
# checking every two seconds for this many seconds, then lets its image calls
# finish before it exits.
RUNNER_ONCE_SECONDS=55
# Optional initial owner bootstrap: only a matching Sites-authenticated owner can use it.
BOOTSTRAP_OWNER_EMAIL=
# Conservative reservations per AI call. These are safety estimates, not invoice caps.
# Site-wide and restaurant daily budgets are editable in Administration (UTC).
# A call never counts more than its reservation. The text ones allow a few
# times a typical call's cost at gpt-4.1-mini prices; raise them for a pricier
# OPENAI_TEXT_MODEL.
AI_IMAGE_RESERVE_USD=2
AI_CAPTION_RESERVE_USD=0.01
AI_ANALYSIS_RESERVE_USD=0.01
AI_IMPORT_RESERVE_USD=0.05
# A finished text call (caption, photo check, menu reading or rewrite) counts
# against the daily budgets at its measured token cost, never more than its
# reservation. Set these to OPENAI_TEXT_MODEL's list prices per million tokens
# (defaults: gpt-4.1-mini). Calls with an uncertain outcome keep their reservation.
AI_TEXT_INPUT_USD_PER_MILLION_TOKENS=0.40
AI_TEXT_OUTPUT_USD_PER_MILLION_TOKENS=1.60
# Without IMAGE_COST_ESTIMATE_USD, a finished image counts its text input, image
# input and output tokens at these prices per million tokens. They must match
# OPENAI_IMAGE_MODEL's price sheet; the defaults are gpt-image-1's list prices.
AI_IMAGE_TEXT_INPUT_USD_PER_MILLION_TOKENS=5
AI_IMAGE_IMAGE_INPUT_USD_PER_MILLION_TOKENS=10
AI_IMAGE_OUTPUT_USD_PER_MILLION_TOKENS=40
# Restaurants without an active paid plan can make at most this many captions,
# photo checks, menu readings and rewrites per UTC day. Images are limited by
# their allowance instead.
AI_FREE_DAILY_TEXT_CALLS=40
# Photo checks for visitors trying Photo Studio before signup, shared by all
# of them, per UTC day and within the site-wide budget. Each network can also
# make at most 20 an hour and AI_GUEST_DAILY_CALLS_PER_NETWORK a day. The sample
# photo, and a photo already read in the past week, are answered without a call
# and don't count toward the daily limits.
AI_GUEST_DAILY_CALLS=500
AI_GUEST_DAILY_CALLS_PER_NETWORK=60
# On an active paid plan, a restaurant that keeps the default $20 daily budget
# can reserve images up to its plan allowance each day (50 x AI_IMAGE_RESERVE_USD
# for Pro). A budget an administrator sets for that restaurant, and the
# site-wide budget, still apply.
# Guests and restaurants without an active paid plan together can use at most
# this percent of the site-wide daily budget, so paid plans always have the
# rest. At 100 they share all of it.
AI_FREE_BUDGET_SHARE_PERCENT=70
# Includes reserved room for public copies; existing photos are accounted for before new uploads.
WORKSPACE_STORAGE_MB=2048

# Monitoring (optional). Point an uptime monitor at /api/health/ready.
# Slack- or Discord-compatible incoming webhook (HTTPS) for operational alerts:
# stale background worker, stuck image queue, site-wide AI budget and error bursts.
ALERT_WEBHOOK_URL=
# Deduplicated error reports (server, background job and browser). Defaults to ALERT_WEBHOOK_URL.
ERROR_WEBHOOK_URL=
# Alert thresholds. The worker counts as stale when it has not checked in for this long.
WORKER_STALE_AFTER_SECONDS=180
QUEUE_ALERT_AFTER_MINUTES=10
AI_BUDGET_ALERT_PERCENT=80
ERROR_BURST_COUNT=10
ERROR_BURST_MINUTES=5
# The same alert condition or error is sent again at most this often.
ALERT_REPEAT_MINUTES=60

# Free and Pro plan limits (lib/plans.ts). Set to false to lift every limit at once.
PLAN_LIMITS_ENABLED=true
# New public accounts each network can open per day; invitations don't count.
SIGNUPS_PER_NETWORK_PER_DAY=5

# Stripe stays inactive until the account, monthly USD $9 price for 50 images, portal and webhook are ready.
# Billing is on only when STRIPE_BILLING_ENABLED=true and the three settings below and APP_ORIGIN are all set;
# otherwise Pro shows as coming soon.
STRIPE_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Contact and legal details only you can supply. Each appears once set; until then pages keep their earlier wording.
# Support address: the footer's Contact link, /contact, the privacy page, pricing questions, sign-in (password
# resets), error pages and the account-deletion message.
SUPPORT_EMAIL=
# Who runs the site, as a legal name and postal address, shown on /contact and the privacy page.
SITE_OPERATOR=
# Where your Terms of Service are published (https://...). /terms redirects there; the footer, signup, Plans, the
# pricing page and Stripe Checkout link to them. Unset, /terms is a 404.
TERMS_URL=
# Optional refund policy page, linked beside Get Pro and in Stripe Checkout. Leave empty if your Terms cover refunds.
REFUND_POLICY_URL=
