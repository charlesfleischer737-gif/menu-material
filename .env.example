# Copy to .env for local development. Keep actual secrets out of Git.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_QUALITY=high
OPENAI_ORCHESTRATOR_MODEL=gpt-6-astra
OPENAI_TEXT_MODEL=gpt-4.1-mini
# Optional accounting estimate per completed image in USD. Not an invoice amount.
IMAGE_COST_ESTIMATE_USD=
# Generate independent random values with: openssl rand -hex 32
ADMIN_SETUP_KEY=
JOB_RUNNER_SECRET=
APP_ORIGIN=http://127.0.0.1:5173
# Optional initial owner bootstrap: only a matching Sites-authenticated owner can use it.
BOOTSTRAP_OWNER_EMAIL=
